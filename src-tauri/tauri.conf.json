{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SeekerShark",
  "version": "0.5.0",
  "identifier": "dev.seekershark.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "SeekerShark", "width": 1200, "height": 800, "minWidth": 360, "minHeight": 600, "backgroundColor": "#050505", "theme": "Dark" }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "android": { "minSdkVersion": 28 }
  }
}
